# ----------------------------------------------------------------------------
# Host Agent configuration — copy this file to `.env` and fill it in.
# Use the SAME Firebase project as the web viewer.
#
# Release builds have these values embedded at build time; the .env file is
# only needed when running from source. No credentials are required: the agent
# signs in anonymously and generates a fresh 9-digit pairing code every time it
# starts (nothing is stored on disk). Make sure the Anonymous provider is
# enabled in Firebase Console -> Authentication -> Sign-in method.
# ----------------------------------------------------------------------------

# An API key of the project WITHOUT application restrictions: the agent is a
# desktop program and sends no website referrer, so a key limited to websites
# rejects it. If the key has API restrictions, they must allow both
# "Identity Toolkit API" and "Token Service API". (Releases embed the
# repository variable FIREBASE_AGENT_API_KEY instead of this file.)
RC_FIREBASE_API_KEY=your-api-key
RC_FIREBASE_PROJECT_ID=your-project-id

# Realtime Database URL (host registry + signaling). Use YOUR instance/region, e.g.
# https://your-project-default-rtdb.<region>.firebasedatabase.app
RC_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com

# Optional: display name (defaults to the machine hostname if empty).
RC_HOST_NAME=

# Optional: Firebase Hosting site id when it differs from the project id
# (firebase/firebase.json -> "hosting": { "site": ... }). The web UI served from
# https://<site>.web.app is then allowed to read this machine's code.
RC_HOSTING_SITE=

# Optional: path to the ffmpeg executable used for screen capture. Leave empty
# to use the ffmpeg shipped with the agent (ffmpeg\ffmpeg.exe next to it, or
# ffmpeg.exe right next to it), or "ffmpeg" from PATH. Without ffmpeg the agent
# still runs without video (the connection and input DataChannel are still
# established).
RC_FFMPEG_PATH=

# Optional: cap on the encoded frame's width in pixels (default 1920). gdigrab
# hands over the whole desktop, all monitors included; anything wider than this
# is scaled down, aspect kept, so the video bitrate still covers what it shows.
# RC_MAX_WIDTH=1920

# Optional: loopback port that serves the pairing code to the local web UI
# (default 47800; must match frontend/src/services/localAgent.ts).
# RC_LOCAL_PORT=47800

# Optional: the one UDP port connections arrive on (default 47801; 0 = any
# free port). It is opened first thing at start-up, which is when Windows asks
# whether to allow the program through its firewall.
# RC_UDP_PORT=47801

# Optional: RC_DIAG=on mirrors the developer's channel (error codes, ICE
# candidate summaries, the commands that fix things) into the window's
# Activity box. The window otherwise only ever shows plain sentences.
# RC_DIAG=off

# Optional: at start-up the agent asks GitHub once, in the background, whether
# a newer release exists and shows an "Update available" button if so. It
# never downloads anything, and a failed or rate-limited answer is silent.
# RC_UPDATE_CHECK=off turns the request off; RC_GITHUB_REPO points a fork's
# build at its own releases (default: the repository that built the exe).
# RC_UPDATE_CHECK=off
# RC_GITHUB_REPO=owner/name

# ----------------------------------------------------------------------------
# For local testing with the Firebase Emulator Suite — leave EMPTY in production:
#   FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
#   FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
# ----------------------------------------------------------------------------
