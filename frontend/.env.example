# ----------------------------------------------------------------------------
# Firebase Web configuration.
# Get these from Firebase Console -> Project settings -> Your apps -> Web app.
# Copy this file to `.env` and fill in your own values. (.env is not committed.)
# These keys are public (they are shipped to the browser); real protection is
# provided by the Firebase Security Rules.
# ----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Realtime Database URL (used for signaling). Use the URL for YOUR database
# instance and region, e.g. https://your-project-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Local development against the Firebase Emulator Suite. Set to 1 to point
# Authentication at 127.0.0.1:9099 and the Realtime Database at 127.0.0.1:9000
# (`firebase emulators:start` in ../firebase). Leave empty for the live project;
# production builds must never set this.
VITE_USE_EMULATORS=
