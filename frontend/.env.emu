# Vite mode "emu": run the viewer against the local Firebase Emulator Suite.
#   npm run dev -- --mode emu
# Values mirror the demo project the emulator tests use (demo-rcapp).
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo-rcapp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rcapp
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_DATABASE_URL=https://demo-rcapp-default-rtdb.firebaseio.com
