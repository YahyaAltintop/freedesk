# =============================================================================
# Remote Control App — root .gitignore
# =============================================================================

# ---- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editors / IDEs / tooling ----------------------------------------------
.vscode/
.idea/
.claude/
*.swp
*.swo

# ---- Node / Frontend (frontend/) -------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files contain Firebase web keys; commit only the example and
# the emulator mode (demo values only).
.env
.env.*
!.env.example
!.env.emu

# ---- Go / Host Agent (host-agent/) -----------------------------------------
# Compiled binaries / libraries
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binaries and coverage output
*.test
*.out
# Go workspace files
go.work
go.work.sum
# Built artifacts
host-agent/bin/
host-agent/dist/

# ---- Firebase ---------------------------------------------------------------
.firebase/
*-debug.log
firebase-debug.*.log
.runtimeconfig.json
# Emulator persisted state
**/emulator-data/
# Frontend build output for Hosting (generated by `npm run build`)
firebase/public/

# ---- Secrets (must never be committed) -------------------------------------
serviceAccount*.json
*service-account*.json
google-services.json
GoogleService-Info.plist
